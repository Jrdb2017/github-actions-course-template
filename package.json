  "license": "MIT",
  "standard": {
    "env": [
      "jest",
      "browser"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/register": "^7.28.3",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "jest": "^29.7.0",
    "html-webpack-plugin": "^5.6.5",
    "standard": "^17.1.2",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {}
